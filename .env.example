# Copy to .env locally; never commit .env
BOT_NAME=BotGajeJir
OWNER_NAME=
# Nomor WhatsApp personal owner (bukan nomor bot)
OWNER_NUMBER=
# Nomor WhatsApp akun BOT untuk pairing pertama. Format: 628xxxxxxxxxx (tanpa + atau spasi).
# Session belum terdaftar + BOT_NUMBER kosong = bot tidak akan connect.
BOT_NUMBER=
# Opsional: isi "qr" untuk pairing via QR. Default: pairing code.
PAIRING_MODE=
COMMAND_MODE=public
KNIGHTBOT_API_KEY=knight
KNIGHTBOT_API_URL=https://knightbotapi.stream
SIPUTZX_API_URL=https://api.siputzx.my.id
GEMINI_API_KEY=
OPENWEATHER_API_KEY=
NEWS_API_KEY=
GIPHY_API_KEY=
TELEGRAM_BOT_TOKEN=
TENOR_API_KEY=
